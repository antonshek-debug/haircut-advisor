# Copy this file to server/.env and fill in the values. server/.env is git-ignored.
# Never put real values in this file.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=

# Supabase secret (service) key. It can read every table, so it must never be
# committed, pasted in a chat, or put in the phone page.
SUPABASE_SERVICE_KEY=
